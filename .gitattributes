# Composer installs nforst/fagus from GitHub's archives, which leave out what is marked here: the
# package is the PHP code in php/, without the engine's sources and tests.
/.github export-ignore
/bench export-ignore
/crates export-ignore
/docs export-ignore
/tests export-ignore
/tools export-ignore
/php/fagus/tests export-ignore
/php/laravel/tests export-ignore
/Cargo.toml export-ignore
/Cargo.lock export-ignore
/clippy.toml export-ignore
/deny.toml export-ignore
/rust-toolchain.toml export-ignore
/rustfmt.toml export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
